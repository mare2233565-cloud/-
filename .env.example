# ==============================================================
#  انسخ هذا الملف باسم .env  (ملف .env لا يرفع على GitHub)
#  على الاستضافة: ضع نفس الأسماء في Environment Variables
# ==============================================================

# البورت: محلياً 5555، وعلى الاستضافة اتركه فارغاً (هم يحددونه)
PORT=5555

# الدومينات المسموحة للدخول، مفصولة بفاصلة.
# مثال: chat.onrender.com,www.mysite.com
# أو اكتب * للسماح بأي دومين (الأسهل للتجربة)
APP_DOMAINS=localhost,127.0.0.1

# ---------------- قاعدة البيانات ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pasowrd-database
DB_NAME=name-database
# 1 لو القاعدة السحابية تطلب SSL (Aiven / TiDB / PlanetScale غالباً 1)
DB_SSL=0

# ---------------- حساب الأدمن الأول ----------------
# يُنشأ مرة واحدة فقط عند أول تشغيل. غيّر الباسورد قبل أول نشر!
ADMIN_USER=aymin
ADMIN_PASSWORD=1111

# ---------------- خيارات ----------------
# HTTPS محلي فقط (على الاستضافة اتركه 0 لأن HTTPS يكون من عندهم)
SSL=0
TRUST_PROXY=1
# نسخ احتياطي تلقائي (يحتاج mysqldump، اتركه 0 على الاستضافة المجانية)
DB_BACKUP=0
# مفتاح يوتيوب اختياري
YOUTUBE_KEY=
