# ==============================================================
#  إعدادات التشغيل المحلي (هذا الملف لا يُرفع على GitHub)
#  املأ بيانات قاعدة البيانات ثم شغّل:  npm start
#  ثم افتح:  http://localhost:5555
# ==============================================================

# البورت محلياً
PORT=5555

# السماح بالدخول من localhost فقط أثناء التجربة
APP_DOMAINS=localhost,127.0.0.1

# ---------------- قاعدة البيانات ----------------
# من لوحة استضافتك (Aiven / TiDB / أي MySQL) انسخ القيم التالية:
#   mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
# اجعلها 1 إذا كانت القاعدة السحابية تطلب SSL (Aiven وTiDB غالباً 1)
DB_SSL=0

# ---------------- حساب الأدمن الأول ----------------
# يُنشأ مرة واحدة فقط عند أول تشغيل، غيّر الباسورد قبل أي نشر
ADMIN_USER=aymin
ADMIN_PASSWORD=1111

# ---------------- خيارات ----------------
SSL=0
DB_BACKUP=0
